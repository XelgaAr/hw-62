<article class="card">
  <a class="card-link" href="<%= root %>articles/<%= article.id %>/">
    <% if (article.image) { %>
    <div class="card-photo"><img src="<%= root %>assets/media/<%= article.image %>.webp" alt="<%= article.alt %>" loading="lazy"></div>
    <% } %>
    <div class="meta"><span class="topic"><%= article.topic || 'Статья' %></span>
      <% if (article.date) { %><time datetime="<%= article.date %>"><%= dateLabel(article.date) %></time><% } %>
    </div>
    <h3><%= article.title %><span class="arrow" aria-hidden="true">→</span></h3>
    <% if (article.summary) { %><p><%= article.summary %></p><% } %>
  </a>
</article>
